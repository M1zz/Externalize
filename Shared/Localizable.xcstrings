    },
    "Free keeps %lld items at a time. Unlock unlimited anytime." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료는 한 번에 %lld개까지 보관해요. 언제든 무제한으로 풀 수 있어요."
          }
        }
      }
    },
    "Free keeps %lld things at a time. Lifetime keeps as many as your day needs — parking, locker, room, gate code, all at once." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료는 한 번에 %lld개까지 보관해요. 평생 이용권이면 주차 위치, 사물함, 방 번호, 현관 비밀번호까지 하루에 필요한 만큼 한꺼번에 담을 수 있어요."
          }
        }
      }
    },
