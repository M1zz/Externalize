      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "뇌모리는 몇 시간만 필요한 정보를 대신 기억하고, 때가 되면 알아서 잊어요."
          }
        }
      }
    },
    "Forget" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
