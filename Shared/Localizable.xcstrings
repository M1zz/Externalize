        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément a besoin d’une fin : le faire, le planifier ou l’abandonner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuna ha bisogno di una conclusione: farla, programmarla o lasciarla perdere."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada item precisa de um fim: fazer, agendar ou descartar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทุกเรื่องต้องมีข้อสรุป ทำเลย กำหนดเวลา หรือทิ้งไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi việc cần một cái kết: làm ngay, hẹn giờ hoặc bỏ đi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Každá věc potřebuje konec: udělat ji, naplánovat ji, nebo zahodit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt skal have en afslutning: gør det, vælg et tidspunkt eller drop det."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάθε σημείωση θέλει ένα τέλος: κάνε την, όρισε ώρα ή πέτα την."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen asia tarvitsee lopun: tee se, ajasta se tai hylkää se."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiap hal perlu diselesaikan: kerjakan, jadwalkan, atau buang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt trenger en avslutning: gjør det, sett en tid eller dropp det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk ding heeft een einde nodig: doe het, plan het of gooi het weg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda sprawa potrzebuje zakończenia: zrób ją, wyznacz czas albo odpuść."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje sak behöver ett slut: gör det, välj en tid eller släng det."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her birinin bir sonu olmalı: yap, zamanla ya da vazgeç."
