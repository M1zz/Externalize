    "Get a thought out of your head. You'll decide what to do with it in the evening." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "머릿속 생각을 꺼내 둡니다. 어떻게 할지는 저녁에 정하면 돼요."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a thought out of your head. You'll decide what to do with it in the evening."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先把脑子里的念头记下来，晚上再决定怎么处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先把腦中的念頭記下來，晚上再決定怎麼處理。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭の中の考えを外に出しておきます。どうするかは夜に決めればOK。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вынесите мысль из головы. Что с ней делать, решите вечером."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saca una idea de tu cabeza. Ya decidirás qué hacer con ella por la noche."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol einen Gedanken aus dem Kopf. Was damit passiert, entscheidest du am Abend."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortez une pensée de votre tête. Vous déciderez quoi en faire le soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tira fuori un pensiero dalla testa. Cosa farne lo decidi la sera."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tire um pensamento da cabeça. À noite você decide o que fazer com ele."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดึงเรื่องที่ผุดขึ้นมาออกจากหัว แล้วค่อยตัดสินใจตอนเย็นว่าจะทำอย่างไร"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đưa suy nghĩ ra khỏi đầu. Tối đến bạn sẽ quyết định làm gì với nó."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaňte myšlenku z hlavy. Co s ní, rozhodnete večer."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en tanke ud af hovedet. Hvad du gør ved den, bestemmer du om aftenen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγάλε μια σκέψη από το μυαλό σου. Το βράδυ θα αποφασίσεις τι θα κάνεις με αυτήν."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ajatuksen pois päästä. Illalla päätät, mitä sille tehdään."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluarkan pikiran dari kepala. Malamnya kamu putuskan mau diapakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få en tanke ut av hodet. Hva du gjør med den, bestemmer du om kvelden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haal een gedachte uit je hoofd. 's Avonds bepaal je wat je ermee doet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyrzuć myśl z głowy. Co z nią zrobić, zdecydujesz wieczorem."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Få ut en tanke ur huvudet. Vad du gör med den bestämmer du på kvällen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aklına gelen şeyi kafandan çıkar. Ne yapacağına akşam karar verirsin."
          }
        }
      }
    },
